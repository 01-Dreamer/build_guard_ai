# BuildGuard AI ignore rules

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Packaging
dist/
build/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Runtime outputs and local datasets
data/
logs/
runs/
outputs/
checkpoints/
tmp/
temp/
uploads/
faces/
camera_frames/
annotated/

# Large model artifacts and ML caches
models/
weights/
*.pt
*.pth
*.onnx
*.engine
*.ckpt
*.safetensors
yolo*.pt

# Local environment and secrets
.env
.env.*
!.env.example

# IDE / OS / editor
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
